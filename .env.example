# ── Required ─────────────────────────────────────────────────────────────
# Postgres (Neon on Vercel). DATABASE_URL_UNPOOLED is used for migrations if set.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wasla?schema=public"
# Long random strings (at least 32 characters each). Never change ENCRYPTION_KEY after
# go-live: stored WhatsApp tokens are encrypted with it.
AUTH_SECRET=""
ENCRYPTION_KEY=""
# Public URL of the site, used in emails and webhook URLs
APP_URL="http://localhost:3000"
# Classic GitHub token with read:packages (installs @vixer-house/whatsapp-kit)
GITHUB_PACKAGES_TOKEN=""

# ── Email (confirmation + password reset) ───────────────────────────────
# Resend (https://resend.com): API key + a sender on a domain you verified there.
RESEND_API_KEY=""
EMAIL_FROM="Wasla <no-reply@yourdomain.com>"
# Development only: show email links on screen instead of sending them
EMAIL_DEV_LINKS=0

# ── AI (POST /api/v1/ai/reply) ──────────────────────────────────────────
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"

# ── Checkout ─────────────────────────────────────────────────────────────
# 1 = show a "Simulate payment" button on checkout (testing only — leave 0 in production)
CHECKOUT_TEST_MODE=0

